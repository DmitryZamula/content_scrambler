{
    "name": "drupal/content_scrambler",
    "type": "drupal-module",
    "description": "Anonymizes local and team development copies of a site by overwriting stored content with replacement text (Lorem Ipsum by default) of the same length.",
    "keywords": [
        "Drupal",
        "lorem ipsum",
        "anonymize",
        "development"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Dmytro Zamula",
            "homepage": "https://github.com/DmitryZamula/content_scrambler"
        }
    ],
    "homepage": "https://www.drupal.org/project/content_scrambler",
    "support": {
        "issues": "https://www.drupal.org/project/issues/content_scrambler",
        "source": "https://git.drupalcode.org/project/content_scrambler"
    },
    "require": {
        "drupal/core": "^11.1"
    }
}
